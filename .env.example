DATABASE_URL="postgresql://gymuser:gympassword@localhost:5432/gymdb?schema=public"

REDIS_URL="redis://localhost:6380"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Calendar del coach (opcional): bloquea en la agenda 1:1 las horas ocupadas del coach.
# Las tres van juntas; vacías = la opción no aparece. Cliente OAuth de tipo "Aplicación web"
# con URI de redirección <URL de la app>/api/coach/calendar/callback.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
# Llave para cifrar los tokens en la base de datos. Generar con: openssl rand -base64 32
# Si se cambia, los coaches conectados tienen que volver a conectar su calendario.
CALENDAR_TOKEN_ENCRYPTION_KEY=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Archivos subidos (SeaweedFS / S3). Vacío = carpeta local uploads/
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Docker Compose (no commitear valores reales)
POSTGRES_USER=gymuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gymdb
REDIS_PASSWORD=change-me

# Producción
DOMAIN=app.example.com
