{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "default_agent": "coordinator",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@bytebase/dbhub@1.5.0", "--config", ".kilo/dbhub.toml"],
      "enabled": true,
      "timeout": 15000
    }
  }
}
