generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TRAINER
  MEMBER
  SUPER_ADMIN
}

enum UserSex {
  MALE
  FEMALE
  OTHER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  TONING
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
  REHABILITATION
  COMPETITION
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  GLUTES
  ABS
  CALVES
  FOREARMS
  TRAPS
  FULL_BODY
  CARDIO
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BAND
  SMITH_MACHINE
  EZ_BAR
  BENCH
  PLATE
  OTHER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  STRIPE
  OTHER
}

enum PaymentType {
  MEMBERSHIP
  CLASS_BOOKING
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  REMINDER
  PAYMENT
  MEMBERSHIP
  CLASS
  CHECK_IN
  GOAL
  SYSTEM
}

model Gym {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  membershipPlans MembershipPlan[]
  classes         Class[]
  gymEquipments   GymEquipment[]
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String           @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  stripeCustomerId String?
  role             UserRole         @default(MEMBER)
  phone            String?
  sex              UserSex?
  birthDate        DateTime?
  objective        FitnessGoal?
  experienceLevel  ExperienceLevel?
  medicalNotes     String?
  emergencyContact String?
  emergencyPhone   String?
  assignedTrainerId String?
  gymId            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  onboardingData        Json?
  trainingFrequency     Int?

  bio               String?
  specialties       Json?
  certifications    Json?
  yearsExperience   Int?

  gym              Gym?              @relation(fields: [gymId], references: [id])
  assignedTrainer  User?             @relation("TrainerClients", fields: [assignedTrainerId], references: [id])
  clients          User[]            @relation("TrainerClients")
  routinePlans            RoutinePlan[]
  assignedRoutinePlans AssignedRoutinePlan[]

  workoutLogs      WorkoutLog[]
  bookings         Booking[]
  payments         Payment[]
  notifications    Notification[]
  memberShips      Membership[]
  checkIns         CheckIn[]
  bodyMeasurements BodyMeasurement[]
  progressPhotos   ProgressPhoto[]
  classes          Class[]           @relation("TrainerClasses")

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MembershipPlan {
  id          String   @id @default(cuid())
  gymId       String
  name        String
  description String?
  price       Float
  currency    String   @default("MXN")
  durationDays Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym        Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships Membership[]
}

model Membership {
  id              String           @id @default(cuid())
  userId          String
  planId          String
  status          MembershipStatus @default(ACTIVE)
  startDate       DateTime         @default(now())
  endDate         DateTime
  autoRenew       Boolean          @default(false)
  paymentConfirmed Boolean         @default(false)
  paymentMethod   PaymentMethod    @default(CASH)
  paymentRef      String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  gymId     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyMeasurement {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @default(now())
  weight      Float?
  height      Float?
  bodyFat     Float?
  muscleMass  Float?
  bmi         Float?
  neck        Float?
  shoulders   Float?
  chest       Float?
  leftArm     Float?
  rightArm    Float?
  leftForearm Float?
  rightForearm Float?
  waist       Float?
  hips        Float?
  leftThigh   Float?
  rightThigh  Float?
  leftCalf    Float?
  rightCalf   Float?
  notes       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  url       String
  date      DateTime @default(now())
  category  String   @default("front")
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GymEquipment {
  id          String   @id @default(cuid())
  gymId       String
  name        String
  category    String?
  imageUrl    String?
  location    String?
  exerciseId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym      Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id])
}

// ── New Routine Models ────────────────────────────────

model RoutinePlan {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  objective   FitnessGoal?
  frequency   Int?
  difficulty  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  splits      RoutineSplit[]
  assignments AssignedRoutinePlan[]
}

model RoutineSplit {
  id                String   @id @default(cuid())
  planId            String
  label             String
  name              String
  description       String?
  muscleGroups      String[]
  estimatedDuration Int?
  difficulty        String?
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plan       RoutinePlan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises   RoutineSplitExercise[]
  workoutLogs WorkoutLog[]
}

model RoutineSplitExercise {
  id          String @id @default(cuid())
  splitId     String
  exerciseId  String
  sets        Int    @default(3)
  reps        String @default("10")
  weight      Float  @default(0)
  restSeconds Int    @default(60)
  order       Int    @default(0)
  notes       String?

  split    RoutineSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model AssignedRoutinePlan {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  active    Boolean  @default(true)
  startedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan RoutinePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
}

// ── Exercise & Workout Models ─────────────────────────

model Exercise {
  id          String      @id @default(cuid())
  name        String
  description String?
  category    String?
  muscleGroup MuscleGroup
  equipment   Equipment   @default(OTHER)
  imageUrl    String?
  videoUrl    String?
  animationData Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  splitExercises RoutineSplitExercise[]
  gymEquipments  GymEquipment[]
}

model WorkoutLog {
  id        String   @id @default(cuid())
  userId    String
  splitId   String?
  date      DateTime @default(now())
  duration  Int?
  notes     String?
  createdAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  split RoutineSplit? @relation(fields: [splitId], references: [id])

  sets WorkoutSetLog[]
}

model WorkoutSetLog {
  id            String  @id @default(cuid())
  workoutLogId  String
  exerciseId    String
  exerciseName  String
  setNumber     Int
  reps          Int     @default(0)
  weight        Float   @default(0)
  restSeconds   Int     @default(60)
  completed     Boolean @default(true)
  rpe           Float?
  rir           Int?
  notes         String?
  createdAt     DateTime @default(now())

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
}

model Class {
  id          String    @id @default(cuid())
  gymId       String?
  name        String
  description String?
  trainerId   String
  capacity    Int
  duration    Int
  dayOfWeek   DayOfWeek
  schedule    DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gym      Gym?      @relation(fields: [gymId], references: [id])
  trainer  User      @relation("TrainerClasses", fields: [trainerId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  classId   String
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  classItem Class @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  amount                Float
  currency              String        @default("mxn")
  status                PaymentStatus @default(PENDING)
  method                PaymentMethod @default(CASH)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  type                  PaymentType   @default(MEMBERSHIP)
  reference             String?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
