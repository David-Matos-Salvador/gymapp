generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TRAINER
  MEMBER
  SUPER_ADMIN
}

enum UserSex {
  MALE
  FEMALE
  OTHER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  TONING
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
  REHABILITATION
  COMPETITION
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  GLUTES
  ABS
  CALVES
  FOREARMS
  TRAPS
  FULL_BODY
  CARDIO
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BAND
  SMITH_MACHINE
  EZ_BAR
  BENCH
  PLATE
  OTHER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  STRIPE
  YAPE
  OTHER
}

enum PaymentType {
  MEMBERSHIP
  CLASS_BOOKING
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  REMINDER
  PAYMENT
  MEMBERSHIP
  CLASS
  CHECK_IN
  GOAL
  SYSTEM
  TRAINER_REQUEST
}

enum TrainerRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InviteStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model Gym {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  email     String?
  logoUrl             String?
  active              Boolean  @default(true)
  isDefault           Boolean  @default(false)
  showMachineNumbers  Boolean  @default(false)
  // Zona horaria IANA del gimnasio: la agenda 1:1 convierte horas locales a UTC con ella.
  timezone            String   @default("America/Lima")
  ownerId             String?  @unique
  owner               User?    @relation("GymOwner", fields: [ownerId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users                  User[]
  membershipPlans        MembershipPlan[]
  classes                Class[]
  gymEquipments          GymEquipment[]
  gymExercises           GymExercise[]
  gymEquipmentActivations GymEquipmentActivation[]
  trainerInvites         TrainerInvite[]
  appointments           Appointment[]
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String           @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  stripeCustomerId String?
  role             UserRole         @default(MEMBER)
  phone            String?
  sex              UserSex?
  birthDate        DateTime?
  objective        FitnessGoal?
  experienceLevel  ExperienceLevel?
  height           Float?
  weight           Float?
  medicalNotes     String?
  emergencyContact String?
  emergencyPhone   String?
  assignedTrainerId String?
  gymId            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  onboardingData        Json?
  trainingFrequency     Int?

  bio               String?
  specialties       Json?
  certifications    Json?
  yearsExperience   Int?

  gym              Gym?              @relation(fields: [gymId], references: [id])
  ownedGym         Gym?              @relation("GymOwner")
  priceChanges     MembershipPlanPriceHistory[] @relation("PriceChangedBy")
  assignedTrainer  User?             @relation("TrainerClients", fields: [assignedTrainerId], references: [id])
  clients          User[]            @relation("TrainerClients")
  routinePlans            RoutinePlan[]
  assignedRoutinePlans AssignedRoutinePlan[]
  exercises        Exercise[]

  workoutLogs      WorkoutLog[]
  bookings         Booking[]
  payments         Payment[]
  notifications    Notification[]
  memberShips      Membership[]
  checkIns         CheckIn[]
  bodyMeasurements BodyMeasurement[]
  progressPhotos   ProgressPhoto[]
  classes          Class[]           @relation("TrainerClasses")
  coachAvailability     CoachAvailability[]
  trainerAppointments   Appointment[] @relation("TrainerAppointments")
  clientAppointments    Appointment[] @relation("ClientAppointments")
  cancelledAppointments Appointment[] @relation("AppointmentCanceller")

  trainerRequestsSent     TrainerRequest[] @relation("TrainerRequestSender")
  trainerRequestsReceived TrainerRequest[] @relation("TrainerRequestReceiver")
  paymentConfirmations    Payment[]        @relation("PaymentConfirmer")
  trainerInvites          TrainerInvite[]  @relation("TrainerInvites")
  invitedByInvites        TrainerInvite[]  @relation("InvitedUsers")

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MembershipPlanPriceHistory {
  id          String   @id @default(cuid())
  planId      String
  oldPrice    Decimal? @db.Decimal(12, 2)
  newPrice    Decimal  @db.Decimal(12, 2)
  oldCurrency String?
  newCurrency String
  changedById String?
  createdAt   DateTime @default(now())

  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  changedBy User?          @relation("PriceChangedBy", fields: [changedById], references: [id])

  @@index([planId, createdAt])
}

model MembershipPlan {
  id          String   @id @default(cuid())
  gymId       String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("PEN")
  durationDays Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  memberships  Membership[]
  priceHistory MembershipPlanPriceHistory[]

  @@unique([gymId, name])
}

model Membership {
  id              String           @id @default(cuid())
  userId          String
  planId          String
  status          MembershipStatus @default(ACTIVE)
  startDate       DateTime         @default(now())
  endDate         DateTime
  autoRenew       Boolean          @default(false)
  paymentConfirmed Boolean         @default(false)
  paymentMethod   PaymentMethod    @default(CASH)
  paymentRef      String?
  notes           String?
  planPrice       Decimal?         @db.Decimal(12, 2)
  planCurrency    String           @default("PEN")
  planDurationDays Int             @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([userId, planId])
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  gymId     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model BodyMeasurement {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @default(now())
  weight      Float?
  height      Float?
  bodyFat     Float?
  muscleMass  Float?
  bmi         Float?
  neck        Float?
  shoulders   Float?
  chest       Float?
  leftArm     Float?
  rightArm    Float?
  leftForearm Float?
  rightForearm Float?
  waist       Float?
  hips        Float?
  leftThigh   Float?
  rightThigh  Float?
  leftCalf    Float?
  rightCalf   Float?
  notes       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  url       String
  date      DateTime @default(now())
  category  String   @default("front")
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GymEquipment {
  id          String   @id @default(cuid())
  gymId       String?
  name        String
  category    String?
  imageUrl      String?
  location      String?
  exerciseId    String?
  machineNumber Int?
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gym         Gym?       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  exercise    Exercise?  @relation(fields: [exerciseId], references: [id])
  activations GymEquipmentActivation[]
}

model GymExercise {
  gymId      String
  exerciseId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  gym      Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@id([gymId, exerciseId])
}

model GymEquipmentActivation {
  gymId         String
  equipmentId   String
  active        Boolean @default(true)
  machineNumber Int?
  imageUrl      String?
  createdAt     DateTime @default(now())

  gym       Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  equipment GymEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  @@id([gymId, equipmentId])
}

// ── New Routine Models ────────────────────────────────

model RoutinePlan {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  objective   FitnessGoal?
  frequency   Int?
  difficulty  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  splits      RoutineSplit[]
  assignments AssignedRoutinePlan[]

  @@unique([name, userId])
}

model RoutineSplit {
  id                String   @id @default(cuid())
  planId            String
  label             String
  name              String
  description       String?
  muscleGroups      String[]
  estimatedDuration Int?
  difficulty        String?
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plan       RoutinePlan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises   RoutineSplitExercise[]
  workoutLogs WorkoutLog[]
}

model RoutineSplitExercise {
  id          String @id @default(cuid())
  splitId     String
  exerciseId  String
  sets        Int    @default(3)
  reps        String @default("10")
  weight      Float  @default(0)
  restSeconds Int    @default(60)
  order       Int    @default(0)
  notes       String?

  split    RoutineSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model AssignedRoutinePlan {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  active    Boolean  @default(true)
  startedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan RoutinePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@unique([userId, planId])
}

// ── Exercise & Workout Models ─────────────────────────

model Exercise {
  id          String      @id @default(cuid())
  name        String
  description String?
  category    String?
  muscleGroup MuscleGroup
  equipment   Equipment   @default(OTHER)
  imageUrl    String?
  videoUrl    String?
  animationData Json?
  userId      String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  creator        User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  splitExercises RoutineSplitExercise[]
  gymEquipments  GymEquipment[]
  gymExercises   GymExercise[]

  @@unique([name])
}

model WorkoutLog {
  id        String   @id @default(cuid())
  userId    String
  splitId   String?
  date      DateTime @default(now())
  duration  Int?
  notes     String?
  createdAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  split RoutineSplit? @relation(fields: [splitId], references: [id])

  sets WorkoutSetLog[]
}

model WorkoutSetLog {
  id            String  @id @default(cuid())
  workoutLogId  String
  exerciseId    String
  exerciseName  String
  setNumber     Int
  reps          Int     @default(0)
  weight        Float   @default(0)
  restSeconds   Int     @default(60)
  completed     Boolean @default(true)
  rpe           Float?
  rir           Int?
  notes         String?
  createdAt     DateTime @default(now())

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
}

model Class {
  id          String    @id @default(cuid())
  gymId       String
  name        String
  description String?
  trainerId   String
  capacity    Int
  duration    Int
  dayOfWeek   DayOfWeek
  startTime   String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gym      Gym       @relation(fields: [gymId], references: [id], onDelete: Restrict)
  trainer  User      @relation("TrainerClasses", fields: [trainerId], references: [id], onDelete: Restrict)
  bookings Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  classId   String
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  classItem Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
}

// Bloque semanal en el que el coach atiende sesiones 1:1 (hora local del gimnasio, "HH:mm").
model CoachAvailability {
  id        String    @id @default(cuid())
  trainerId String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  trainer User @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@unique([trainerId, dayOfWeek, startTime])
  @@index([trainerId])
}

// Sesión 1:1 entre un coach y su cliente. Se cancela cambiando el estado: nunca se borra.
model Appointment {
  id              String            @id @default(cuid())
  gymId           String
  trainerId       String
  clientId        String
  startsAt        DateTime
  durationMinutes Int               @default(60)
  status          AppointmentStatus @default(CONFIRMED)
  cancelledById   String?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  gym         Gym   @relation(fields: [gymId], references: [id], onDelete: Restrict)
  trainer     User  @relation("TrainerAppointments", fields: [trainerId], references: [id], onDelete: Restrict)
  client      User  @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Restrict)
  cancelledBy User? @relation("AppointmentCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([trainerId, startsAt])
  @@index([clientId, startsAt])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  membershipId          String?
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("PEN")
  status                PaymentStatus @default(PENDING)
  method                PaymentMethod @default(CASH)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  type                  PaymentType   @default(MEMBERSHIP)
  reference             String?
  notes                 String?
  receiptUrl            String?
  confirmedById         String?
  confirmedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  confirmedBy User?       @relation("PaymentConfirmer", fields: [confirmedById], references: [id])

  @@index([membershipId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainerRequest {
  id         String               @id @default(cuid())
  trainerId  String
  clientId   String
  status     TrainerRequestStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  acceptedAt DateTime?
  rejectedAt DateTime?

  trainer User @relation("TrainerRequestSender", fields: [trainerId], references: [id], onDelete: Cascade)
  client  User @relation("TrainerRequestReceiver", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@index([clientId])
  @@index([status])
  @@unique([trainerId, clientId])
}

model TrainerInvite {
  id           String       @id @default(cuid())
  token        String       @unique
  trainerId    String
  gymId        String?
  name         String?
  email        String?
  phone        String?
  status       InviteStatus @default(PENDING)
  expiresAt    DateTime
  usedByUserId String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())

  trainer User?      @relation("TrainerInvites", fields: [trainerId], references: [id], onDelete: Cascade)
  gym     Gym?       @relation(fields: [gymId], references: [id], onDelete: SetNull)
  usedBy  User?      @relation("InvitedUsers", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([trainerId])
  @@index([status])
}
